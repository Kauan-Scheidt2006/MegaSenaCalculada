prefix=@DEFERRED@CMAKE_INSTALL_PREFIX@DEFERRED@
exec_prefix=${prefix}
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/@OPENXLSX_LIBRARY_NAME@
libdir=${exec_prefix}/lib

Name: @OPENXLSX_LIBRARY_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Cflags: -I"${includedir}"
Requires.private: pugixml-OpenXLSX >= 1.15 miniz-OpenXLSX
Libs: -L${libdir} -Wl,-rpath,${libdir} -lOpenXLSX
Libs.private: 
